; lofigrey: the lofi look (clean low polygons, realistic weathering) in crunch's colours:
; greys, a muted red drum, khaki brass.
;   python gen/build.py liedersanger_lo --style lofigrey  ->  out/liedersanger_lo-lofigrey/

(style lofigrey
  (base lofi)
  (palette
    (teal 118 120 124)
    (white 164 164 160)
    (red 150 74 66)
    (gunmetal 112 112 116)
    (brass 150 148 116)
    (black 150 76 68)
    (steel 150 150 154)
    (rubber 52 52 54)))
