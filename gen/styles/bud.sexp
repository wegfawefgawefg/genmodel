; bud: vvlo in a friend's game look: mottled greys with white edge chips and orange rust
; flecks, muted brick-red and khaki accents, a tiny nearest-filtered texture.

(style bud
  (base vvlo)
  (texture 128 nearest)
  (grain 0.3)
  (grain-tint 0.03)
  (rust-specks 0.025)
  (chips 0.35)
  (grime 0.6)
  (rust 0.25)
  (cool-edges 0.25)
  (palette
    (teal 128 130 134)
    (white 172 172 170)
    (red 150 68 60)
    (gunmetal 104 104 108)
    (brass 158 154 118)
    (black 142 66 60)
    (steel 168 170 174)
    (rubber 46 46 48)))
